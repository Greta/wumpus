{
  "name": "wumpus",
  "version": "0.2.0",
  "private": true,
  "description": "Hunt the Wumpus. A pixel-art cave adventure for keyboard and touch.",
  "homepage": "https://greta.github.io/wumpus/",
  "author": "Greta Prisby",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build --base-href /wumpus/",
    "test": "ng test --watch=false",
    "verify:classic": "node scripts/verify-classic.mjs",
    "check": "npm run verify:classic && npm test && npm run build"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "jsdom": "^29.0.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
